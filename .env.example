# Vantage — ortam değişkenleri örneği
#
# Bu dosya ŞABLONDUR: gerçek değerleri buraya yazıp commit etmeyin.
# İki yol var:
#   1) Bu değişkenleri işletim sistemi / servis tanımı üzerinden verin (önerilen),
#   2) ya da `backend/.secrets.env` dosyasına yazın — uygulama açılışta okur
#      (o dosya .gitignore'ludur). Arayüzden girilen token'lar da oraya yazılır.
#
# Gerçek ortam değişkeni her zaman .secrets.env'i EZER.

# --- Zorunlu (üretimde) -------------------------------------------------------

# JWT imza anahtarı. Verilmezse açılışta güçlü rastgele bir anahtar üretilip
# .secrets.env'e yazılır — ama üretimde anahtarın yaşam döngüsü sizde olsun.
# Üretmek için: python -c "import secrets; print(secrets.token_hex(32))"
VANTAGE_SECRET=

# Veritabanı bağlantısı. config/config.yaml'daki değeri EZER; kimlik bilgisi
# config'e değil buraya yazılır (config dosyası git'e girer).
DATABASE_URL=postgresql+psycopg://kullanici:parola@localhost:5432/vantage

# --- Opsiyonel ----------------------------------------------------------------

# Anket cevaplarının şifreleme anahtarı (Fernet). Yoksa üretmek için:
#   python -m app.cli survey-genkey
SURVEY_ENC_KEY=

# AI kod analizi (config'te llm.provider: claude ise gerekir).
ANTHROPIC_API_KEY=

# GitHub: oran sınırını yükseltir, özel repo erişimi sağlar.
# ("Projelerim" modülü public repo için tokensiz de çalışır.)
GITHUB_TOKEN=

# Görev kaynağı — Trello (config'te sources.tasks.provider: trello ise)
TRELLO_KEY=
TRELLO_TOKEN=

# Görev kaynağı — Jira (sources.tasks.provider: jira ise)
JIRA_TOKEN=

# Git kaynağı — GitLab (sources.git.provider: gitlab ise)
GITLAB_TOKEN=

# --- Yol ayarları (nadiren gerekir) -------------------------------------------

# Farklı bir config dosyası kullan (varsayılan: config/config.yaml)
# VANTAGE_CONFIG=/etc/vantage/config.yaml
